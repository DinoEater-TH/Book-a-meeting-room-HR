# --- Google login (no Supabase) ---
# Create a Google OAuth "Web application" client in Google Cloud Console.
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-DOMAIN/api/auth/callback/google  (production)
# If these are empty, the app runs in local "dev mode" and skips login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret used to sign the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=kku.ac.th
# Comma-separated emails with permission to edit/cancel anyone's booking.
# Leave empty in dev mode to allow all.
ADMIN_EMAILS=

# --- Google Sheets as the booking database ---
# If these are empty, bookings are stored in .data/bookings.json instead.
GOOGLE_SHEETS_ID=1IByz6Lg7pqOb1e_WOdW_tE05_GPgEJiPdMgKNDqHhsQ
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole private key. Keep the \n escapes or use a quoted multiline value.
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_TAB=Bookings
